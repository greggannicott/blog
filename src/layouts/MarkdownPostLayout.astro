---
import BaseLayout from "./BaseLayout.astro"
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  <p class="published-date">Published: {frontmatter.pubDate.toString().slice(0,10)}</p>
  <slot />
  <hr />
  <p>See other posts about:</p>
  <ul>
    {frontmatter.tags.map((topic: string) => (
    <li><a href={`/topics/${topic}`}>{topic}</a></li>
    ))}
  </ul>
</BaseLayout>
